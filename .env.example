# ===========================================
# CIVIX - Environment Variables
# ===========================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic (Claude) - For INE OCR & AI features
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI - For Whisper audio transcription
OPENAI_API_KEY=sk-...

# Twilio - For WhatsApp OTP
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Resend - For Email OTP
RESEND_API_KEY=re_...

# Google Maps (optional - for map display)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=AIza...

# Mapbox - For electoral maps with PostGIS polygons
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here

# App config
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
